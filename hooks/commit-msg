#!/bin/sh
# commit-msg hook — provenance gate (fail-closed). Copy into .git/hooks/commit-msg.
# Resolver order: $PROVGATE env, repo-root/provgate.py, installed nimbus scripts copy.
# No resolver found -> REJECT the commit (fail-closed per 2026-11-17 decision).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
for PG in "${PROVGATE:-}" "$ROOT/provgate.py" "$HOME/AppData/Local/hermes/profiles/nimbus/scripts/provgate.py" "$HOME/.hermes/profiles/nimbus/scripts/provgate.py"; do
    if [ -n "$PG" ] && [ -f "$PG" ]; then
        exec python "$PG" check-message -F "$1"
    fi
done
echo "provgate: provgate.py not found (set PROVGATE=/abs/path/provgate.py) — commit refused (fail-closed)" >&2
exit 1
